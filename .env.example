# Required for AI chat agent
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional — email notifications when agent captures a lead (https://resend.com)
# RESEND_API_KEY=re_...
# LEAD_NOTIFICATION_EMAIL=info@altroofingsolutionsinc.com
# LEAD_FROM_EMAIL=leads@altroofingsolutions.com

# Optional — POST lead JSON to a webhook (Zapier, Make, CRM, etc.)
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/...
